# MongoDB Atlas connection string
MONGODB_URI=

# Secret used to sign admin session JWTs — use a long random string
JWT_SECRET=

# Single admin login, used by `npm run seed` to create the Admin document.
# The plaintext password below is only read once during seeding; it is
# hashed with bcrypt before being stored.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (Dashboard > Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (resend.com/api-keys) — powers the Contact section
RESEND_API_KEY=
# Inbox that contact form submissions get delivered to
CONTACT_TO_EMAIL=
# Optional: only needed once you verify a custom sending domain in Resend.
# Defaults to Resend's shared sandbox address, which works without any setup.
RESEND_FROM_EMAIL=
